---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

import rooftop from "../assets/iris/hero-rooftop.jpg";
import irisCutout from "../assets/iris/iris-cutout.png";
import irisLogo from "../assets/iris/iris-logo.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative isolate flex min-h-[100svh] items-end overflow-hidden">
  <Image
    src={rooftop}
    alt=""
    class="absolute inset-0 -z-30 h-full w-full object-cover"
    widths={[960, 1600]}
    sizes="100vw"
    loading="eager"
  />
  <!-- Iris looks back toward the title; anchored right so phones keep her face in view -->
  <Image
    src={irisCutout}
    alt=""
    class="hero-iris absolute -right-[22%] top-16 -z-20 h-[60svh] w-auto sm:-right-[6%] md:bottom-0 md:right-[3%] md:top-auto md:h-[92%]"
    widths={[480, 900]}
    sizes="(min-width: 768px) 520px, 60vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-x-0 bottom-0 -z-10 h-3/4 bg-gradient-to-t from-night via-night/80 to-transparent md:h-1/2 md:via-night/40"></div>
  <div class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-night/80 via-night/30 to-transparent md:block"></div>

  <div class="mx-auto w-full max-w-6xl px-4 pb-16 pt-40 sm:px-8 md:pb-24">
    <h1>
      <Image
        src={irisLogo}
        alt={t("hero.logoAlt")}
        widths={[400, 800, 1200]}
        sizes="(min-width: 768px) 600px, 90vw"
        class="h-auto w-[min(90vw,600px)]"
        loading="eager"
      />
    </h1>
    <p class="mt-8 max-w-[34ch] text-lg text-bone/90 md:text-xl">
      {t("hero.tagline")}<br />{t("hero.hook")}
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="https://store.steampowered.com/app/3349520/Iris_Dissolution"
        target="_blank"
        rel="noopener"
        class="bg-blood px-6 py-4 text-lg font-bold text-bone transition-colors hover:bg-bone hover:text-night"
      >
        {t("hero.wishlist")}
      </a>
      <a href="#iris" class="inline-block py-4 text-lg text-bone underline decoration-ice/60 underline-offset-8 hover:decoration-ice">
        {t("hero.more")}
      </a>
    </div>
    <p class="mt-8 text-sm text-fog">{t("hero.platform")}</p>
  </div>
</section>

<style>
  .hero-iris {
    animation: emerge 1.8s ease-out both;
  }

  @keyframes emerge {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }
</style>
