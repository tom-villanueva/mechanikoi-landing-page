---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

import iris from "../assets/games/iris.webp";
import br from "../assets/games/br.webp";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const games = [
  {
    img: iris,
    title: t("games.iris.title"),
    meta: t("games.iris.meta"),
    desc: t("games.iris.desc"),
    page: translatePath("/iris-dissolution"),
    store: { label: t("iris.cta"), url: "https://store.steampowered.com/app/3349520/Iris_Dissolution" },
  },
  {
    img: br,
    title: t("games.br.title"),
    meta: t("games.br.meta"),
    desc: t("games.br.desc"),
    page: translatePath("/bleeding-roots"),
    store: { label: t("games.br.steam"), url: "https://store.steampowered.com/app/3091770" },
  },
];
---

<section id="games" class="scroll-mt-24 px-4 py-12 sm:px-8 md:py-16">
  <div class="mx-auto max-w-6xl">
    <p class="font-mono text-sm text-secondary">~/mechanikoi/games</p>
    <h2 class="mt-2 text-4xl text-primary lg:text-6xl">{t("projects.title")}</h2>
    <div class="mt-4 divide-y divide-detail">
    {games.map((game) => (
      <article class="grid items-center gap-8 py-10 md:grid-cols-2 md:gap-12">
        <a href={game.page} tabindex="-1" aria-hidden="true">
          <Image
            src={game.img}
            alt=""
            width={600}
            height={338}
            class="h-auto w-full border-2 border-detail transition-colors hover:border-primary"
            loading="lazy"
          />
        </a>
        <div>
          <h3 class="text-3xl text-primary">{game.title}</h3>
          <p class="mt-2 font-mono text-sm text-secondary">// {game.meta}</p>
          <p class="mt-4 max-w-prose text-lg leading-relaxed text-secondary">{game.desc}</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a
              href={game.page}
              class="rounded-sm border-2 border-primary bg-primary px-5 py-3 font-bold text-blackish transition-colors hover:bg-blackish hover:text-primary"
            >
              {t("games.page")}
            </a>
            <a
              href={game.store.url}
              target="_blank"
              rel="noopener"
              class="inline-block py-2 text-primary underline decoration-primary/50 underline-offset-8 hover:decoration-primary"
            >
              {game.store.label}
            </a>
          </div>
        </div>
      </article>
    ))}
    </div>
  </div>
</section>
