---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type NavItem = {
  title: string,
  url: string
}

interface Props {
  navItems: NavItem[]
}

const { navItems: footerItems } = Astro.props;

const socialItems = [
  {
    title: "Discord",
    url: "https://discord.gg/sqzZJmKt7E"
  },
  {
    title: "Twitter",
    url: "https://x.com/MechanikoiGames"
  },
  {
    title: "Instagram",
    url: "https://www.instagram.com/mechanikoi/"
  },
  {
    title: "LinkedIn",
    url: "https://ar.linkedin.com/company/mechanikoigames"
  },
  {
    title: "YouTube",
    url: "https://www.youtube.com/@MechaniKoi"
  },
  {
    title: "Steam",
    url: "https://steamcommunity.com/groups/mechanikoi"
  },
  {
    title: "BlueSky",
    url: "https://bsky.app/profile/mechanikoigames.bsky.social"
  },
]
---
<footer class="w-full shrink-0 border-t border-muted/20 px-4 sm:px-8">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-10 py-12 md:flex-row">
    <div>
      <p class="text-3xl text-ink">
        MechaniKOI
      </p>
      <p class="mt-1 text-sm text-muted">{t("footer.title")}</p>
      <a class="mt-6 inline-block py-1.5 text-sm text-ink hover:underline" href="mailto:development@mechanikoi.com.ar">development@mechanikoi.com.ar</a>
    </div>
    <!-- <a href="/">
      <Image
        src={logo}
        class="h-auto"
        alt="Mechanikoi logo icon"
        height={100}
        decoding="async"
        loading="lazy"
      />
    </a> -->
  <div class="flex flex-row gap-x-16 sm:gap-x-24">

    <div>
      <p class="pb-3 text-sm text-muted">{t("footer.menu")}</p>
      <ul class="list-none text-ink">
        {
          footerItems.map(({ title, url }) => (
            <li class="text-sm hover:underline">
              <a class="inline-block py-1.5" href={url}>
                {title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="pb-3 text-sm text-muted">{t("footer.social")}</p>
      <ul class="list-none text-ink">
        {
          socialItems.map(({ title, url }) => (
            <li class="text-sm hover:underline">
              <a class="inline-block py-1.5" href={url} target="_blank" rel="noopener">
                {title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
    
  </div>
  <p class="pb-1 pt-2 text-center text-sm text-muted/70">
    © {new Date().getFullYear()} MechaniKOI
  </p>
  <p class="pb-6 pt-1 text-center text-xs text-muted/70">
    {t("footer.dedicatory")}{" "}
    <a class="underline" href="https://www.linkedin.com/in/tomas-villanueva-jousset/" target="_blank" rel="noopener">Tom</a>
  </p>
</footer>