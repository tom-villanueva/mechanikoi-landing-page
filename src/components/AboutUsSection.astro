---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import logo from "../assets/logo.png";
import team from "../assets/team.jpg";
import { SHOW_ABOUT_PHOTO } from "../config";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="scroll-mt-24 px-4 py-12 sm:px-8 md:py-16">
  <div class:list={["mx-auto grid max-w-6xl items-center gap-12", SHOW_ABOUT_PHOTO && "md:grid-cols-[3fr_2fr]"]}>
    <div class="flex gap-6 sm:gap-10">
      <!-- the koi swims upward: against the current -->
      <Image src={logo} alt="" width={90} height={157} class="h-auto w-14 shrink-0 self-start drop-shadow-sm sm:w-20" loading="lazy" />
        <div>
        <p class="font-mono text-sm text-secondary">~/mechanikoi/about</p>
        <h2 class="mt-2 text-4xl text-primary lg:text-6xl">{t("about.title")}</h2>
        <!-- styled like an editor window floating over the page grid -->
        <div class="mt-10 max-w-3xl border border-detail bg-blackish/80 backdrop-blur-sm">
          <div class="flex items-center gap-2 border-b border-detail px-4 py-2 font-mono text-xs text-secondary" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-detail"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-detail"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-detail"></span>
            <span class="ml-2">about.md</span>
          </div>
          <div class="p-5 sm:p-8">
            <h3 class="text-2xl font-bold uppercase text-primary"><span class="font-mono font-normal text-secondary/60" aria-hidden="true">## </span>{t("about.firstTitle")}</h3>
            <p class="mt-3 max-w-prose text-lg leading-relaxed text-secondary">{t("about.firstParagraph")}</p>
            <h3 class="mt-8 text-2xl font-bold uppercase text-primary"><span class="font-mono font-normal text-secondary/60" aria-hidden="true">## </span>{t("about.secondTitle")}</h3>
            <p class="mt-3 max-w-prose text-lg leading-relaxed text-secondary">{t("about.secondParagraph")}</p>
          </div>
        </div>
      </div>
    </div>
    {SHOW_ABOUT_PHOTO && (
    <Image
      src={team}
      alt={t("about.imageAlt")}
      widths={[480, 800]}
      sizes="(min-width: 768px) 40vw, 100vw"
      class="mx-auto aspect-[4/5] h-auto w-full max-w-md border-2 border-primary object-cover object-[50%_70%]"
      loading="lazy"
    />
    )}
  </div>
</section>
