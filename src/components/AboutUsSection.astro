---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import logo from "../assets/logo.png";
import team from "../assets/team.jpg";
import { SHOW_ABOUT_PHOTO } from "../config";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="scroll-mt-24 px-4 py-24 sm:px-8">
  <div class:list={["mx-auto grid max-w-6xl items-center gap-12", SHOW_ABOUT_PHOTO && "md:grid-cols-[3fr_2fr]"]}>
    <div class="flex gap-6 sm:gap-10">
      <!-- the koi swims upward: against the current -->
      <Image src={logo} alt="" width={90} height={157} class="h-auto w-14 shrink-0 self-start drop-shadow-sm sm:w-20" loading="lazy" />
        <div>
        <p class="font-mono text-sm text-secondary">~/mechanikoi/about</p>
        <h2 class="mt-2 text-4xl text-primary lg:text-6xl">{t("about.title")}</h2>
        <h3 class="mt-10 border-l-2 border-t-2 border-primary pl-3 pt-2 text-2xl font-bold uppercase text-primary">{t("about.firstTitle")}</h3>
        <p class="max-w-prose border-l-2 border-primary pb-4 pl-3 pt-3 text-lg leading-relaxed text-secondary">{t("about.firstParagraph")}</p>
        <h3 class="mt-8 border-l-2 border-t-2 border-primary pl-3 pt-2 text-2xl font-bold uppercase text-primary">{t("about.secondTitle")}</h3>
        <p class="max-w-prose border-l-2 border-primary pb-4 pl-3 pt-3 text-lg leading-relaxed text-secondary">{t("about.secondParagraph")}</p>
      </div>
    </div>
    {SHOW_ABOUT_PHOTO && (
    <Image
      src={team}
      alt={t("about.imageAlt")}
      widths={[480, 800]}
      sizes="(min-width: 768px) 40vw, 100vw"
      class="mx-auto aspect-[4/5] h-auto w-full max-w-md border-2 border-primary object-cover object-[50%_70%]"
      loading="lazy"
    />
    )}
  </div>
</section>
