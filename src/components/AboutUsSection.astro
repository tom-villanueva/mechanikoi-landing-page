---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import logo from "../assets/logo.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="scroll-mt-24 border-t border-fog/20 px-4 py-24 sm:px-8">
  <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-[3fr_2fr]">
    <div class="flex gap-6 sm:gap-10">
      <!-- the koi swims upward: against the current -->
      <Image src={logo} alt="" width={90} height={157} class="h-auto w-14 shrink-0 self-start sm:w-20" loading="lazy" />
      <div>
        <h2 class="font-display text-3xl text-bone md:text-4xl">{t("about.title")}</h2>
        <h3 class="mt-8 text-xl font-bold text-bone">{t("about.firstTitle")}</h3>
        <p class="mt-3 max-w-prose text-lg leading-relaxed">{t("about.firstParagraph")}</p>
        <h3 class="mt-8 text-xl font-bold text-bone">{t("about.secondTitle")}</h3>
        <p class="mt-3 max-w-prose text-lg leading-relaxed">{t("about.secondParagraph")}</p>
      </div>
    </div>
    <!-- PLACEHOLDER: team photo, 4:3, the team at their desks or at an event. -->
    <div
      class="flex aspect-[4/3] w-full items-center justify-center border-2 border-dashed border-fog/40 bg-deep text-fog"
      role="img"
      aria-label={t("about.photoNote")}
    >
      {t("about.photoNote")}
    </div>
  </div>
</section>
