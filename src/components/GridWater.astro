<!-- Animated version of the studio page grid: slow drift, a gentle wave, and ripples spreading from the koi.
     Only runs without prefers-reduced-motion; otherwise the static CSS grid on <body> stays. -->
<canvas id="grid-water" class="pointer-events-none fixed inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>

<script>
  const CELL = 48; // matches the CSS grid size in Layout
  const STEP = 12; // px between points along each line
  const WAVE = 3; // px of wave displacement
  const DRIFT = 8; // px/s the grid scrolls up
  const RIPPLE_EVERY = 5; // s between rings
  const RIPPLE_SPEED = 140; // px/s ring growth
  const RIPPLE_AMP = 10; // px push at the ring's crest

  const canvas = document.getElementById("grid-water") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const koi = document.querySelector(".koi");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  let frame = 0;

  const resize = () => {
    const dpr = Math.min(devicePixelRatio, 2);
    canvas.width = innerWidth * dpr;
    canvas.height = innerHeight * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  };

  const draw = (ms: number) => {
    const t = ms / 1000;
    const w = innerWidth;
    const h = innerHeight;
    const r = koi?.getBoundingClientRect();
    const ox = r ? r.left + r.width / 2 : w / 2;
    const oy = r ? r.top + r.height / 2 : h / 2;

    const point = (x: number, y: number): [number, number] => {
      let dx = WAVE * Math.sin(y * 0.02 + t * 0.8 + x * 0.004);
      let dy = WAVE * Math.sin(x * 0.02 + t * 0.6 + y * 0.004);
      const rx = x - ox;
      const ry = y - oy;
      const d = Math.hypot(rx, ry) || 1;
      // two rings alive at once, each lives 2 * RIPPLE_EVERY seconds and fades out
      for (const k of [0, 1]) {
        const age = (t % RIPPLE_EVERY) + k * RIPPLE_EVERY;
        const crest = Math.exp(-(((d - age * RIPPLE_SPEED) / 50) ** 2));
        const push = RIPPLE_AMP * (1 - age / (2 * RIPPLE_EVERY)) * crest;
        dx += (rx / d) * push;
        dy += (ry / d) * push;
      }
      return [x + dx, y + dy];
    };

    ctx.clearRect(0, 0, w, h);
    ctx.strokeStyle = "rgb(5 244 64 / 0.06)";
    ctx.lineWidth = 1;
    ctx.beginPath();
    const shift = (t * DRIFT) % CELL;
    for (let x = 0; x <= w + CELL; x += CELL) {
      for (let y = -STEP; y <= h + STEP; y += STEP) {
        const [px, py] = point(x, y);
        y === -STEP ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
      }
    }
    for (let y = -shift; y <= h + CELL; y += CELL) {
      for (let x = -STEP; x <= w + STEP; x += STEP) {
        const [px, py] = point(x, y);
        x === -STEP ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
      }
    }
    ctx.stroke();
    frame = requestAnimationFrame(draw);
  };

  const toggle = () => {
    cancelAnimationFrame(frame);
    const on = !reduced.matches;
    document.documentElement.classList.toggle("grid-water", on);
    if (on) frame = requestAnimationFrame(draw);
    else ctx.clearRect(0, 0, canvas.width, canvas.height);
  };

  resize();
  addEventListener("resize", resize);
  reduced.addEventListener("change", toggle);
  toggle();
</script>
