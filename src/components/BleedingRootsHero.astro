---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

import wall from "../assets/br/hero-wall.jpg";
import logo from "../assets/br/br-logo.png";
import plant from "../assets/br/plant.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative isolate flex min-h-[100svh] items-end overflow-hidden">
  <Image
    src={wall}
    alt=""
    class="absolute inset-0 -z-30 h-full w-full object-cover"
    widths={[960, 1920]}
    sizes="100vw"
    loading="eager"
  />
  <!-- the plant/heart, cut out of the key art; anchored right like Iris on her page -->
  <Image
    src={plant}
    alt=""
    class="hero-plant absolute -right-[18%] top-16 -z-20 h-[55svh] w-auto sm:-right-[4%] md:bottom-0 md:right-[4%] md:top-auto md:h-[92%]"
    widths={[480, 853]}
    sizes="(min-width: 768px) 560px, 60vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-x-0 bottom-0 -z-10 h-3/4 bg-gradient-to-t from-page via-page/60 to-transparent md:h-2/5 md:via-page/20"></div>
  <div class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-page/60 via-page/10 to-transparent md:block"></div>

  <div class="mx-auto w-full max-w-6xl px-4 pb-16 pt-28 sm:px-8 md:pb-20">
    <h1>
      <!-- the press-kit logo with its heartbeat pulse; still version for reduced motion -->
      <picture>
        <source srcset={logo.src} media="(prefers-reduced-motion: reduce)" />
        <img
          src="/br/logo-animated.gif"
          alt={t("games.br.title")}
          width={logo.width}
          height={logo.height}
          class="-ml-[6%] h-auto w-[min(80vw,380px)]"
        />
      </picture>
    </h1>
    <p class="mt-8 max-w-[34ch] text-lg text-ink/90 md:text-xl">{t("br.tagline")}</p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="https://store.steampowered.com/app/3091770"
        target="_blank"
        rel="noopener"
        class="bg-accent px-6 py-4 text-lg font-bold text-ink transition-colors hover:bg-ink hover:text-page"
      >
        {t("games.br.steam")}
      </a>
      <a
        href="https://mechanikoi.itch.io/bleedingroots"
        target="_blank"
        rel="noopener"
        class="inline-block py-4 text-lg text-ink underline decoration-accent/60 underline-offset-8 hover:decoration-accent"
      >
        {t("games.br.itch")}
      </a>
    </div>
    <p class="mt-8 text-sm text-muted">{t("games.br.meta")}</p>
  </div>
</section>

<style>
  .hero-plant {
    animation: emerge 1.8s ease-out both;
  }

  @keyframes emerge {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }
</style>
