---
// Two rigged koi that swim in place. Each PNG is cut into a body and two pectoral fins: the body is a WebGL
// mesh bent along a spine (a sine wave of bend travelling head -> tail), the fins are hinged to the body and
// fan on their own. Drop it inside the rotating square; it fills it and never rotates anything itself.
import { Image } from "astro:assets";
import mechanikoiLeft from "../assets/mechanikoiLeft.png";
import mechanikoiRight from "../assets/mechanikoiRight.png";
---

<div class="koi-swim relative h-full w-full" data-koi-swim>
  <!-- the still images: shown without JS/WebGL, with reduced motion, and used as the texture source -->
  <Image src={mechanikoiLeft} class="absolute left-0 top-[14%] h-[72%] w-[72%]" alt="" widths={[600, 1000]} sizes="(min-width: 768px) 42vw, 83vw" loading="eager" />
  <Image src={mechanikoiRight} class="absolute right-0 top-[14%] h-[72%] w-[72%]" alt="" widths={[600, 1000]} sizes="(min-width: 768px) 42vw, 83vw" loading="eager" />
  <canvas class="absolute inset-0 h-full w-full"></canvas>
</div>

<style>
  .koi-swim canvas {
    visibility: hidden;
  }
  .koi-swim[data-running] canvas {
    visibility: visible;
  }
  .koi-swim[data-running] img {
    visibility: hidden;
  }
</style>

<script>
  // Tunables
  const PERIOD = 3.6; // seconds per swim cycle; the loop is exact
  const BEND = 0.2; // extra body heading at the tail tip, in radians (0.2 ≈ 11°)
  const FALLOFF = 2.5; // bend grows as d^FALLOFF, d = 0 at the head, 1 at the tail tip: higher = stiffer front
  const WAVELENGTH = 1; // in body lengths; > 1 means less than one full S-bend along the body
  const CAUDAL = 0.3; // tail fin paddle: extra swing at the tail base, in radians either way (0.3 ≈ 17°)
  const CAUDAL_LAG = 1.6; // how far the paddle trails the body wave, in radians (≈ a quarter cycle, like a real fish)
  const RECOIL = 0.08; // whole-fish yaw so the head swings opposite the tail, in radians either way (0.08 ≈ 4.6°)
  const PIVOT = 0.35; // where the fish yaws around, 0 = head, 1 = tail tip (a real koi's centre of mass)
  const FIN_SWING = 0.14; // pectoral fin fan, in radians either way around its hinge
  const FIN_LAG = 0.9; // fins trail the body wave by this much, in radians
  const GRID = 20; // body mesh cell size, in PNG pixels
  const FIN_CELLS = 8; // fin mesh is FIN_CELLS x FIN_CELLS

  // The rig, in the left PNG's 0..1000 pixel space. The right PNG is the same drawing turned 180°.
  const SPINE = [[255, 975], [245, 900], [235, 820], [205, 740], [185, 650], [165, 560], [145, 470], [130, 390], [125, 330], [140, 290], [185, 215], [250, 125], [345, 25]]; // head -> tail tip
  const PEDUNCLE = [140, 290]; // the narrow tail base where the tail fin hinges
  const FINS = [
    { hinge: [96, 715], dir: 1, poly: [[91, 700], [91, 650], [80, 632], [0, 632], [0, 810], [122, 810], [112, 770], [104, 740], [88, 722]] },
    { hinge: [292, 690], dir: -1, poly: [[289, 700], [289, 640], [330, 610], [400, 578], [462, 578], [462, 725], [420, 752], [345, 752], [328, 746], [316, 732], [300, 716]] },
  ];
  // where each fish sits inside the square (matches the old <Image> classes); phase puts the second fish behind
  const FISH = [
    { rect: [0, 0.14, 0.72, 0.72], turned: false, phase: 0 },
    { rect: [0.28, 0.14, 0.72, 0.72], turned: true, phase: 2.2 },
  ];

  const TAU = Math.PI * 2;
  const N = 48; // spine samples
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const pot = (n: number) => 2 ** Math.ceil(Math.log2(n));

  type Pt = number[];

  // resample a polyline to N points evenly spaced by arc length
  const resample = (pts: Pt[]) => {
    const cum = [0];
    for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
    const out: Pt[] = [];
    for (let k = 0, j = 0; k < N; k++) {
      const s = (cum[cum.length - 1] * k) / (N - 1);
      while (j < pts.length - 2 && cum[j + 1] < s) j++;
      const f = (s - cum[j]) / (cum[j + 1] - cum[j]);
      out.push([pts[j][0] + (pts[j + 1][0] - pts[j][0]) * f, pts[j][1] + (pts[j + 1][1] - pts[j][1]) * f]);
    }
    return out;
  };

  // fractional spine index of the point nearest to p
  const nearest = (sp: Pt[], p: Pt) => {
    let best = Infinity, at = 0;
    for (let i = 0; i < N - 1; i++) {
      const [ax, ay] = sp[i], dx = sp[i + 1][0] - ax, dy = sp[i + 1][1] - ay;
      const f = Math.min(1, Math.max(0, ((p[0] - ax) * dx + (p[1] - ay) * dy) / (dx * dx + dy * dy)));
      const d = Math.hypot(ax + dx * f - p[0], ay + dy * f - p[1]);
      if (d < best) (best = d), (at = i + f);
    }
    return at;
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-koi-swim]")) {
    const imgs = [...root.querySelectorAll("img")];
    const canvas = root.querySelector("canvas")!;
    const gl = canvas.getContext("webgl", { premultipliedAlpha: true, antialias: false });
    if (!gl) continue; // the still images stay

    const shader = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, shader(gl.VERTEX_SHADER, "attribute vec4 a;varying vec2 v;void main(){v=a.zw;gl_Position=vec4(a.xy,0,1);}"));
    gl.attachShader(prog, shader(gl.FRAGMENT_SHADER, "precision mediump float;uniform sampler2D t;varying vec2 v;void main(){gl_FragColor=texture2D(t,v);}"));
    gl.bindAttribLocation(prog, 0, "a");
    gl.linkProgram(prog);
    gl.useProgram(prog);
    gl.enableVertexAttribArray(0);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
    gl.clearColor(0, 0, 0, 0);

    // a mipmapped texture painted by a 2D canvas callback
    const texture = (w: number, h: number, paint: (g: CanvasRenderingContext2D) => void) => {
      const c = document.createElement("canvas");
      c.width = w;
      c.height = h;
      paint(c.getContext("2d")!);
      const t = gl.createTexture();
      gl.bindTexture(gl.TEXTURE_2D, t);
      gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, c);
      gl.generateMipmap(gl.TEXTURE_2D);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      return t;
    };

    // cut one PNG into textures and build its meshes
    const build = (f: (typeof FISH)[number], img: HTMLImageElement) => {
      const T = (p: Pt) => (f.turned ? [1000 - p[0], 1000 - p[1]] : p);
      const spine = resample(SPINE.map(T));
      const hinge = nearest(spine, T(PEDUNCLE)) / (N - 1); // tail base, as a 0..1 position along the spine
      const fins = FINS.map((fin) => ({ ...fin, hinge: T(fin.hinge), poly: fin.poly.map(T) }));
      const finPath = new Path2D();
      for (const fin of fins) finPath.addPath(new Path2D("M" + fin.poly.join("L") + "Z"));

      // body texture: the whole PNG with the fins cut out
      const bodyTex = texture(1024, 1024, (g) => {
        g.scale(1.024, 1.024);
        g.drawImage(img, 0, 0, 1000, 1000);
        g.globalCompositeOperation = "destination-out";
        g.fill(finPath);
      });
      // fin texture: only the fins, cropped to their shared bounding box
      const all = fins.flatMap((fin) => fin.poly);
      const fx = Math.min(...all.map((p) => p[0])), fy = Math.min(...all.map((p) => p[1]));
      const fw = pot(Math.max(...all.map((p) => p[0])) - fx), fh = pot(Math.max(...all.map((p) => p[1])) - fy);
      const finTex = texture(fw, fh, (g) => {
        g.translate(-fx, -fy);
        g.clip(finPath);
        g.drawImage(img, 0, 0, 1000, 1000);
      });

      // body mesh: a regular grid over the fish; each vertex rides its nearest spine point
      const xs = spine.map((p) => p[0]).concat(all.map((p) => p[0]));
      const x0 = Math.max(0, Math.min(...xs) - 140), x1 = Math.min(1000, Math.max(...xs) + 140);
      const cols = Math.ceil((x1 - x0) / GRID) + 1, rows = Math.ceil(1000 / GRID) + 1;
      const verts: { x: number; y: number; at: number }[] = [];
      for (let r = 0; r < rows; r++)
        for (let c = 0; c < cols; c++) {
          const x = Math.min(x1, x0 + c * GRID), y = Math.min(1000, r * GRID);
          verts.push({ x, y, at: nearest(spine, [x, y]) });
        }
      const idx: number[] = [];
      for (let r = 0; r < rows - 1; r++)
        for (let c = 0; c < cols - 1; c++) {
          const i = r * cols + c;
          idx.push(i, i + 1, i + cols, i + 1, i + cols + 1, i + cols);
        }
      const nBody = idx.length;
      // each fin is a small grid over its polygon's box, hinged at its root. Like a weighted mesh in Spine,
      // a vertex turns by w * swing, w = 0 at the root and 1 at the far edge: the root stays glued to the body.
      let base = verts.length;
      const finMeshes = fins.map((fin) => {
        const px = fin.poly.map((p) => p[0]), py = fin.poly.map((p) => p[1]);
        const a = Math.min(...px), b = Math.max(...px), c = Math.min(...py), d = Math.max(...py);
        let ox = (a + b) / 2 - fin.hinge[0], oy = (c + d) / 2 - fin.hinge[1]; // outward, from hinge to box centre
        const len = Math.hypot(ox, oy);
        (ox /= len), (oy /= len);
        const pts: { x: number; y: number; w: number }[] = [];
        for (let r = 0; r <= FIN_CELLS; r++)
          for (let k = 0; k <= FIN_CELLS; k++) {
            const x = a + ((b - a) * k) / FIN_CELLS, y = c + ((d - c) * r) / FIN_CELLS;
            pts.push({ x, y, w: Math.max(0, (x - fin.hinge[0]) * ox + (y - fin.hinge[1]) * oy) });
          }
        const far = Math.max(...pts.map((p) => p.w));
        for (const p of pts) p.w = Math.min(1, p.w / far);
        for (let r = 0; r < FIN_CELLS; r++)
          for (let k = 0; k < FIN_CELLS; k++) {
            const i = base + r * (FIN_CELLS + 1) + k, n = FIN_CELLS + 1;
            idx.push(i, i + 1, i + n, i + 1, i + n + 1, i + n);
          }
        base += pts.length;
        return { ...fin, at: nearest(spine, fin.hinge), pts };
      });

      const vbo = gl.createBuffer();
      const ibo = gl.createBuffer();
      gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, ibo);
      gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array(idx), gl.STATIC_DRAW);
      const data = new Float32Array(base * 4);
      return { ...f, spine, hinge, verts, finMeshes, fx, fy, fw, fh, bodyTex, finTex, vbo, ibo, nBody, nAll: idx.length, data };
    };

    let fish: ReturnType<typeof build>[] = [];
    let t = 0, last = 0, raf = 0, visible = true;
    const bend = new Float32Array(N), sx = new Float32Array(N), sy = new Float32Array(N);

    const draw = () => {
      gl.clear(gl.COLOR_BUFFER_BIT);
      const wt = (TAU * t) / PERIOD;
      for (const f of fish) {
        const { spine, data, rect } = f;
        // bend travels head -> tail (k*d - wt); past the tail base the whole fin also swings as a paddle,
        // trailing the body. The spine is then rebuilt from the head with the extra heading.
        const paddle = CAUDAL * Math.sin((TAU / WAVELENGTH) * f.hinge - wt + f.phase - CAUDAL_LAG);
        for (let i = 0; i < N; i++) {
          const d = i / (N - 1);
          const past = Math.min(1, Math.max(0, (d - f.hinge) / 0.08 + 0.5)); // eases in over the tail base
          bend[i] = BEND * d ** FALLOFF * Math.sin((TAU / WAVELENGTH) * d - wt + f.phase) + paddle * past * past * (3 - 2 * past);
        }
        // recoil: the same extra heading everywhere turns the whole fish; in step with the rear body, so the
        // head swings the other way. The pivot is pinned below, after the spine is rebuilt.
        const yaw = RECOIL * Math.sin((TAU / WAVELENGTH) * 0.8 - wt + f.phase);
        for (let i = 0; i < N; i++) bend[i] += yaw;
        sx[0] = spine[0][0];
        sy[0] = spine[0][1];
        for (let i = 0; i < N - 1; i++) {
          const dx = spine[i + 1][0] - spine[i][0], dy = spine[i + 1][1] - spine[i][1];
          const a = (bend[i] + bend[i + 1]) / 2, c = Math.cos(a), s = Math.sin(a);
          sx[i + 1] = sx[i] + dx * c - dy * s;
          sy[i + 1] = sy[i] + dx * s + dy * c;
        }
        const p = Math.round(PIVOT * (N - 1)), shx = spine[p][0] - sx[p], shy = spine[p][1] - sy[p];
        for (let i = 0; i < N; i++) (sx[i] += shx), (sy[i] += shy);
        // a point rides its nearest spine point: carried along with it and turned by its bend.
        // extra turns it first around the pivot (ox, oy), for the fins.
        const move = (x: number, y: number, at: number, extra: number, ox: number, oy: number, o: number) => {
          const i = Math.min(N - 2, Math.floor(at)), g = at - i;
          const rx = spine[i][0] + (spine[i + 1][0] - spine[i][0]) * g, ry = spine[i][1] + (spine[i + 1][1] - spine[i][1]) * g;
          const px = sx[i] + (sx[i + 1] - sx[i]) * g, py = sy[i] + (sy[i + 1] - sy[i]) * g;
          const a = bend[i] + (bend[i + 1] - bend[i]) * g, c = Math.cos(a), s = Math.sin(a);
          const ec = Math.cos(extra), es = Math.sin(extra);
          const qx = ox + (x - ox) * ec - (y - oy) * es - rx, qy = oy + (x - ox) * es + (y - oy) * ec - ry;
          data[o] = (rect[0] + ((px + qx * c - qy * s) / 1000) * rect[2]) * 2 - 1;
          data[o + 1] = 1 - (rect[1] + ((py + qx * s + qy * c) / 1000) * rect[3]) * 2;
        };
        let o = 0;
        for (const v of f.verts) {
          move(v.x, v.y, v.at, 0, 0, 0, o);
          data[o + 2] = v.x / 1000; // the PNG was stretched to fill the 1024 texture
          data[o + 3] = v.y / 1000;
          o += 4;
        }
        for (const q of f.finMeshes) {
          const swing = q.dir * FIN_SWING * Math.sin(wt - FIN_LAG + f.phase);
          for (const { x, y, w } of q.pts) {
            move(x, y, q.at, swing * w, q.hinge[0], q.hinge[1], o);
            data[o + 2] = (x - f.fx) / f.fw;
            data[o + 3] = (y - f.fy) / f.fh;
            o += 4;
          }
        }
        gl.bindBuffer(gl.ARRAY_BUFFER, f.vbo);
        gl.bufferData(gl.ARRAY_BUFFER, data, gl.DYNAMIC_DRAW);
        gl.vertexAttribPointer(0, 4, gl.FLOAT, false, 0, 0);
        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, f.ibo);
        gl.bindTexture(gl.TEXTURE_2D, f.bodyTex);
        gl.drawElements(gl.TRIANGLES, f.nBody, gl.UNSIGNED_SHORT, 0);
        gl.bindTexture(gl.TEXTURE_2D, f.finTex);
        gl.drawElements(gl.TRIANGLES, f.nAll - f.nBody, gl.UNSIGNED_SHORT, f.nBody * 2);
      }
    };

    const frame = (now: number) => {
      t = (t + Math.min(now - last, 50) / 1000) % PERIOD; // clamp dt so resuming never jumps
      last = now;
      draw();
      raf = requestAnimationFrame(frame);
    };

    const update = () => {
      const run = fish.length > 0 && visible && !document.hidden && !reduce.matches;
      if (run && !raf) {
        last = performance.now();
        draw();
        root.dataset.running = "";
        raf = requestAnimationFrame(frame);
      } else if (!run && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
      if (reduce.matches) delete root.dataset.running; // back to the still <img>s
    };

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      update();
    }).observe(root);
    document.addEventListener("visibilitychange", update);
    reduce.addEventListener("change", update);

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(root.clientWidth * dpr);
      canvas.height = Math.round(root.clientHeight * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      if (fish.length && !raf) draw(); // keep a paused canvas in step with the new size
    };
    new ResizeObserver(resize).observe(root);

    // textures need the decoded PNGs; if one fails to load, never start and the <img>s stay as they are
    Promise.all(imgs.map((img) => img.decode()))
      .then(() => {
        fish = FISH.map((f, n) => build(f, imgs[n]));
        resize(); // don't wait for the observer: the first frame must already be full size
        update();
      })
      .catch(() => {});

    // the browser can drop the GL context (background tabs on mobile): fall back to the stills for good
    canvas.addEventListener("webglcontextlost", () => {
      cancelAnimationFrame(raf);
      raf = 0;
      fish = [];
      delete root.dataset.running;
    });
  }
</script>
