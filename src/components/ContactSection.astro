---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="scroll-mt-24 border-t border-detail px-4 py-16 sm:px-8 md:py-20">
  <div class="mx-auto flex max-w-6xl flex-col gap-12 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-mono text-sm text-secondary">~/mechanikoi/contact</p>
      <h2 class="mt-2 text-4xl text-primary lg:text-6xl">{t("contact.title")}</h2>
      <p class="mt-6 max-w-[42ch] text-lg leading-relaxed text-secondary">{t("contact.firstParagraph")}</p>
      <a
        href="https://discord.gg/sqzZJmKt7E"
        target="_blank"
        rel="noopener"
        class="mt-10 inline-flex items-center gap-3 rounded-sm border-2 border-primary bg-primary px-6 py-4 text-lg font-bold text-blackish transition-colors hover:bg-blackish hover:text-primary"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M13.545 2.907a13.2 13.2 0 0 0-3.257-1.011.05.05 0 0 0-.052.025c-.141.25-.297.577-.406.833a12.2 12.2 0 0 0-3.658 0 8 8 0 0 0-.412-.833.05.05 0 0 0-.052-.025c-1.125.194-2.22.534-3.257 1.011a.04.04 0 0 0-.021.018C.356 6.024-.213 9.047.066 12.032q.003.022.021.037a13.3 13.3 0 0 0 3.995 2.02.05.05 0 0 0 .056-.019q.463-.63.818-1.329a.05.05 0 0 0-.01-.059l-.018-.011a9 9 0 0 1-1.248-.595.05.05 0 0 1-.02-.066l.015-.019q.127-.095.248-.195a.05.05 0 0 1 .051-.007c2.619 1.196 5.454 1.196 8.041 0a.05.05 0 0 1 .053.007q.121.1.248.195a.05.05 0 0 1-.004.085 8 8 0 0 1-1.249.594.05.05 0 0 0-.03.03.05.05 0 0 0 .003.041c.24.465.515.909.817 1.329a.05.05 0 0 0 .056.019 13.2 13.2 0 0 0 4.001-2.02.05.05 0 0 0 .021-.037c.334-3.451-.559-6.449-2.366-9.106a.03.03 0 0 0-.02-.019m-8.198 7.307c-.789 0-1.438-.724-1.438-1.612s.637-1.613 1.438-1.613c.807 0 1.45.73 1.438 1.613 0 .888-.637 1.612-1.438 1.612m5.316 0c-.788 0-1.438-.724-1.438-1.612s.637-1.613 1.438-1.613c.807 0 1.451.73 1.438 1.613 0 .888-.631 1.612-1.438 1.612"/>
        </svg>
        {t("contact.discordCta")}
      </a>
    </div>
    <dl class="grid gap-6 text-lg">
      <div>
        <dt class="font-mono text-sm text-secondary">{t("contact.email")}</dt>
        <dd><a class="text-primary hover:underline" href="mailto:development@mechanikoi.com.ar">development@mechanikoi.com.ar</a></dd>
      </div>
      <div>
        <dt class="font-mono text-sm text-secondary">X / Twitter</dt>
        <dd><a class="text-primary hover:underline" href="https://x.com/MechanikoiGames" target="_blank" rel="noopener">@MechanikoiGames</a></dd>
      </div>
      <div>
        <dt class="font-mono text-sm text-secondary">Instagram</dt>
        <dd><a class="text-primary hover:underline" href="https://www.instagram.com/mechanikoi/" target="_blank" rel="noopener">@mechanikoi</a></dd>
      </div>
      <div>
        <dt class="font-mono text-sm text-secondary">Bluesky</dt>
        <dd><a class="text-primary hover:underline" href="https://bsky.app/profile/mechanikoigames.bsky.social" target="_blank" rel="noopener">@mechanikoigames.bsky.social</a></dd>
      </div>
    </dl>
  </div>
</section>
