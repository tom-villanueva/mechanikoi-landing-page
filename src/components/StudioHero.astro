---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

import mechanikoiLeft from "../assets/mechanikoiLeft.png";
import mechanikoiRight from "../assets/mechanikoiRight.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="flex min-h-[100svh] flex-col items-center justify-center gap-20 px-4 pb-16 pt-28 lg:flex-row lg:gap-48">
  <div class="text-center">
    <p class="font-mono text-secondary"><span class="text-primary">&gt;</span> {t("studio.hero.first")}</p>
    <h1 class="mt-2 text-6xl text-primary drop-shadow-sm lg:text-8xl">
      MechaniKOI<span class="cursor" aria-hidden="true">_</span>
    </h1>
    <p class="mt-2 text-xl text-secondary">“{t("studio.hero.second")}”</p>
    <a
      href="#games"
      class="mt-12 inline-block rounded-sm border-2 border-primary bg-primary px-6 py-4 text-lg font-bold text-blackish transition-colors hover:bg-blackish hover:text-primary"
    >
      {t("studio.hero.button")}
    </a>
    <p class="mt-10 font-mono text-sm text-secondary">
      // {t("studio.hero.now")}:
      <a href={translatePath("/iris-dissolution")} class="inline-block py-2 text-primary underline decoration-primary/50 underline-offset-4 hover:decoration-primary">
        Iris Dissolution
      </a>
    </p>
  </div>

  <div class="flex rotate-180 animate-spin" aria-hidden="true">
    <Image src={mechanikoiLeft} class="h-auto drop-shadow-sm" alt="" width={145} height={145} loading="eager" />
    <Image src={mechanikoiRight} class="h-auto drop-shadow-sm" alt="" width={145} height={145} loading="eager" />
  </div>
</section>

<style>
  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
