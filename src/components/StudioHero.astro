---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

import mechanikoiLeft from "../assets/mechanikoiLeft.png";
import mechanikoiRight from "../assets/mechanikoiRight.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<!-- Same skeleton as the game heroes: art on the right, title block bottom-left over a darkening gradient -->
<section class="grid-bg relative isolate flex min-h-[100svh] items-end overflow-hidden">
  <!-- the two koi circle each other; anchored right like Iris on her page -->
  <div
    class="absolute left-1/2 top-32 -z-20 w-[min(92vw,60svh)] -translate-x-1/2 md:left-auto md:right-0 md:top-1/2 md:w-[min(46vw,84svh)] md:translate-x-0 md:-translate-y-1/2"
    aria-hidden="true"
  >
    <div class="flex rotate-180 animate-spin">
      <Image src={mechanikoiLeft} class="h-auto w-1/2 drop-shadow-sm" alt="" widths={[300, 600]} sizes="(min-width: 768px) 26vw, 46vw" loading="eager" />
      <Image src={mechanikoiRight} class="h-auto w-1/2 drop-shadow-sm" alt="" widths={[300, 600]} sizes="(min-width: 768px) 26vw, 46vw" loading="eager" />
    </div>
  </div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-3/4 bg-gradient-to-t from-blackish via-blackish/80 to-transparent md:h-1/2 md:via-blackish/40"></div>
  <div class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-blackish via-blackish/60 to-transparent md:block"></div>

  <div class="mx-auto w-full max-w-6xl px-4 pb-16 pt-40 sm:px-8 md:pb-24">
    <p class="font-mono text-secondary"><span class="text-primary">&gt;</span> {t("studio.hero.first")}</p>
    <h1 class="mt-2 text-6xl text-primary drop-shadow-sm sm:text-7xl lg:text-8xl">
      MechaniKOI<span class="cursor" aria-hidden="true">_</span>
    </h1>
    <p class="mt-4 text-xl text-secondary md:text-2xl">“{t("studio.hero.second")}”</p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#games"
        class="rounded-sm border-2 border-primary bg-primary px-6 py-4 text-lg font-bold text-blackish transition-colors hover:bg-blackish hover:text-primary"
      >
        {t("studio.hero.button")}
      </a>
    </div>
    <p class="mt-8 font-mono text-sm text-secondary">
      // {t("studio.hero.now")}:
      <a href={translatePath("/iris-dissolution")} class="inline-block py-2 text-primary underline decoration-primary/50 underline-offset-4 hover:decoration-primary">
        Iris Dissolution
      </a>
    </p>
  </div>
</section>

<style>
  /* faint terminal grid in the slot where the game heroes have their key art */
  .grid-bg {
    background-image:
      linear-gradient(rgb(5 244 64 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(5 244 64 / 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
