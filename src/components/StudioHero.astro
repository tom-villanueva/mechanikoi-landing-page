---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

import mechanikoiLeft from "../assets/mechanikoiLeft.png";
import mechanikoiRight from "../assets/mechanikoiRight.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<!-- Same skeleton as the game heroes: art on the right, title block bottom-left -->
<section class="relative isolate flex min-h-[100svh] items-end overflow-hidden">
  <!-- the two koi sit on opposite sides of one circle and chase each other; the mask fades them out
       behind the title instead of painting a gradient over the page grid -->
  <div
    class="koi absolute left-1/2 top-24 -z-10 aspect-square w-[min(115vw,62svh)] -translate-x-1/2 md:left-auto md:right-0 md:top-[54%] md:w-[min(58vw,86svh)] md:translate-x-0 md:-translate-y-1/2"
    aria-hidden="true"
  >
    <div class="relative h-full w-full animate-spin [animation-direction:reverse]">
      <Image src={mechanikoiLeft} class="absolute left-0 top-[14%] h-[72%] w-[72%] drop-shadow-sm" alt="" widths={[600, 1000]} sizes="(min-width: 768px) 42vw, 83vw" loading="eager" />
      <Image src={mechanikoiRight} class="absolute right-0 top-[14%] h-[72%] w-[72%] drop-shadow-sm" alt="" widths={[600, 1000]} sizes="(min-width: 768px) 42vw, 83vw" loading="eager" />
    </div>
  </div>

  <div class="mx-auto w-full max-w-6xl px-4 pb-16 pt-40 sm:px-8 md:pb-24">
    <p class="font-mono text-secondary"><span class="text-primary">&gt;&nbsp;</span>{t("studio.hero.first")}</p>
    <h1 class="mt-2 text-6xl text-primary drop-shadow-sm sm:text-7xl lg:text-8xl">
      MechaniKOI<span class="cursor" aria-hidden="true">_</span>
    </h1>
    <p class="mt-4 text-xl text-secondary md:text-2xl">“{t("studio.hero.second")}”</p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#games"
        class="rounded-sm border-2 border-primary bg-primary px-6 py-4 text-lg font-bold text-blackish transition-colors hover:bg-blackish hover:text-primary"
      >
        {t("studio.hero.button")}
      </a>
    </div>
    <p class="mt-8 font-mono text-sm text-secondary">
      // {t("studio.hero.now")}:
      <a href={translatePath("/iris-dissolution")} class="inline-block py-2 text-primary underline decoration-primary/50 underline-offset-4 hover:decoration-primary">
        Iris Dissolution
      </a>
    </p>
  </div>
</section>

<style>
  .koi {
    mask-image: linear-gradient(to bottom, black 45%, transparent 85%);
  }

  @media (min-width: 768px) {
    .koi {
      mask-image: linear-gradient(to right, transparent 0%, black 25%);
    }
  }

  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
