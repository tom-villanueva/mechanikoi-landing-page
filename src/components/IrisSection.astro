---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

import shotCamera from "../assets/iris/stairwell.png";
import shotAmmo from "../assets/iris/hallway.png";
import shotPuzzle from "../assets/iris/puzzle-bells.png";
import shotInventory from "../assets/iris/inventory.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = [
  { id: "f1", src: shotCamera, name: t("iris.f1.name"), desc: t("iris.f1.desc"), alt: t("iris.f1.alt") },
  { id: "f2", src: shotAmmo, name: t("iris.f2.name"), desc: t("iris.f2.desc"), alt: t("iris.f2.alt") },
  { id: "f3", src: shotPuzzle, name: t("iris.f3.name"), desc: t("iris.f3.desc"), alt: t("iris.f3.alt") },
  { id: "f4", src: shotInventory, name: t("iris.f4.name"), desc: t("iris.f4.desc"), alt: t("iris.f4.alt") },
];
---

<section id="iris" class="scroll-mt-24 px-4 py-24 sm:px-8 md:py-32">
  <div class="mx-auto grid max-w-6xl gap-16 lg:grid-cols-[2fr_3fr] lg:gap-20">
    <div>
      <h2 class="font-display text-3xl leading-tight text-bone md:text-4xl">
        {t("iris.title")}
      </h2>
      <p class="mt-8 max-w-prose text-lg leading-relaxed">{t("iris.story1")}</p>
      <p class="mt-4 max-w-prose text-lg leading-relaxed">{t("iris.story2")}</p>
      <p class="mt-4 max-w-prose text-lg leading-relaxed text-bone">{t("iris.story3")}</p>
      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href="https://store.steampowered.com/app/3349520/Iris_Dissolution"
          target="_blank"
          rel="noopener"
          class="bg-blood px-6 py-4 font-bold text-bone transition-colors hover:bg-bone hover:text-night"
        >
          {t("iris.cta")}
        </a>
        <a href={`/${lang}/blog/iris-dissolution`} class="inline-block py-2 text-bone underline decoration-ice/60 underline-offset-8 hover:decoration-ice">
          {t("iris.devlog")}
        </a>
        <a
          href="https://drive.google.com/drive/folders/12HAT3lyDOPyLl13dgNdBhOCcvzCULKC6?usp=drive_link"
          target="_blank"
          rel="noopener"
          class="inline-block py-2 text-bone underline decoration-ice/60 underline-offset-8 hover:decoration-ice"
        >
          {t("iris.presskit")}
        </a>
      </div>
    </div>

    <!-- Styled after the game's own inventory screen -->
    <div class="inventory self-start border-2 border-ice/70 bg-deep p-3 sm:p-4">
      <h3 class="sr-only">{t("iris.inventory")}</h3>
      <p class="mb-3 px-1 text-sm text-fog">{t("iris.inventoryHint")}</p>
      <div class="grid gap-3 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
        <div role="tablist" aria-label={t("iris.inventory")} aria-orientation="vertical" class="flex flex-col gap-2">
          {items.map((item, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${item.id}`}
              aria-controls={`panel-${item.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="slot flex items-center gap-3 rounded-md border-2 border-transparent bg-night/50 p-2 text-left text-bone"
            >
              <Image
                src={item.src}
                alt=""
                width={96}
                height={54}
                class="h-12 w-16 shrink-0 rounded-sm border-2 border-ice/60 object-cover"
                loading="lazy"
              />
              <span class="text-lg">{item.name}</span>
            </button>
          ))}
        </div>
        {items.map((item, i) => (
          <div
            role="tabpanel"
            id={`panel-${item.id}`}
            aria-labelledby={`tab-${item.id}`}
            hidden={i !== 0}
            class="space-y-4"
          >
            <Image
              src={item.src}
              alt={item.alt}
              widths={[640, 960]}
              sizes="(min-width: 1024px) 420px, 100vw"
              class="aspect-video w-full rounded-sm border-2 border-ice/60 object-cover"
              loading="lazy"
            />
            <p class="px-1 pb-2 text-lg leading-snug text-bone">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".inventory [role=tab]")];

  const select = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
    });
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (e) => {
      const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (!step) return;
      e.preventDefault();
      const next = tabs[(i + step + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });
  });
</script>

<style>
  .slot:hover {
    @apply border-ice/40;
  }
  .slot[aria-selected="true"] {
    @apply border-ice bg-ice/20;
  }
</style>
