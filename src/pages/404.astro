---
import GridWater from '../components/GridWater.astro';
import Layout from '../layouts/Layout.astro';
---

<!-- One page for both languages: Apache serves it for any unknown URL (ErrorDocument in public/.htaccess) -->
<Layout title="404 | MechaniKOI" description="Page not found.">
	<GridWater />
	<main id="main" class="flex min-h-[100svh] items-center">
		<div class="mx-auto w-full max-w-6xl px-4 py-40 sm:px-8">
			<p class="font-mono text-secondary"><span class="text-primary">&gt;&nbsp;</span>error 404</p>
			<h1 class="mt-2 text-5xl text-primary drop-shadow-sm sm:text-7xl">Page not found</h1>
			<p class="mt-4 text-xl text-secondary md:text-2xl" lang="es">No encontramos esta página.</p>
			<div class="mt-10 flex flex-wrap items-center gap-4">
				<a href="/" class="rounded-sm border-2 border-primary bg-primary px-6 py-4 text-lg font-bold text-blackish transition-colors hover:bg-blackish hover:text-primary">Back to home</a>
				<a href="/es/" lang="es" class="rounded-sm border-2 border-primary px-6 py-4 text-lg font-bold text-primary transition-colors hover:bg-primary hover:text-blackish">Volver al inicio</a>
			</div>
		</div>
	</main>
</Layout>
