---
import AboutUsSection from '../components/AboutUsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import GamesSection from '../components/GamesSection.astro';
import GridWater from '../components/GridWater.astro';
import StudioHero from '../components/StudioHero.astro';
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout title="MechaniKOI | Against the current!" description={t("meta.studio")}>
	<GridWater />
	<main id="main">
		<StudioHero />
		<AboutUsSection />
		<GamesSection />
		<ContactSection />
	</main>
</Layout>
