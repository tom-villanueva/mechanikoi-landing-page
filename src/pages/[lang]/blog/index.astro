---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = (await getCollection("blog"))
  .filter((post) => post.slug.split("/")[0] === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const [latest, ...older] = posts;

const byYear = new Map<number, typeof older>();
for (const post of older) {
  const year = post.data.date.getFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}

const href = (post: (typeof posts)[number]) => `/${lang}/blog/${post.slug.split("/")[1]}`;
const formatDate = (d: Date) => d.toLocaleDateString(lang, { day: "numeric", month: "long", year: "numeric" });
---

<Layout title="MechaniKOI | Blog" description={t("blog.subtitle")} theme="iris">
  <main id="main" class="px-4 pb-24 pt-32 sm:px-8 md:pt-40">
    <div class="mx-auto max-w-6xl">
      <h1 class="font-display text-5xl text-bone md:text-7xl">{t("blog.title")}</h1>
      <p class="mt-4 max-w-[48ch] text-lg">{t("blog.subtitle")}</p>

      {latest && (
        <article class="group relative mt-14 grid items-center gap-8 border-2 border-ice/40 bg-deep p-4 transition-colors hover:border-ice md:grid-cols-2 md:gap-12 md:p-6">
          {latest.data.cover && (
            <Image src={latest.data.cover} alt="" widths={[480, 800]} sizes="(min-width: 768px) 560px, 100vw" class="aspect-video h-auto w-full object-cover" />
          )}
          <div>
            <time datetime={latest.data.date.toISOString()} class="text-sm text-fog">{formatDate(latest.data.date)}</time>
            <h2 class="mt-2 font-display text-3xl text-bone md:text-5xl">
              <a href={href(latest)} class="after:absolute after:inset-0">{latest.data.title}</a>
            </h2>
            {latest.data.description && <p class="mt-4 max-w-prose text-lg leading-relaxed">{latest.data.description}</p>}
            <p class="mt-6 inline-block text-bone underline decoration-ice/60 underline-offset-8 group-hover:decoration-ice">{t("blog.read")}</p>
          </div>
        </article>
      )}

      {[...byYear].map(([year, list]) => (
        <section class="mt-20">
          <h2 class="border-b border-fog/20 pb-3 font-display text-2xl text-bone">{year}</h2>
          <ul>
            {list.map((post) => (
              <li class="border-b border-fog/20">
                <article class="group relative grid grid-cols-[6.5rem_1fr] items-start gap-4 py-6 sm:grid-cols-[12rem_1fr] sm:gap-8">
                  {post.data.cover && (
                    <Image src={post.data.cover} alt="" width={384} class="aspect-video h-auto w-full object-cover opacity-80 transition-opacity group-hover:opacity-100" />
                  )}
                  <div>
                    <time datetime={post.data.date.toISOString()} class="text-sm text-fog">{formatDate(post.data.date)}</time>
                    <h3 class="mt-1 font-display text-xl text-bone sm:text-2xl">
                      <a href={href(post)} class="underline decoration-transparent underline-offset-8 after:absolute after:inset-0 group-hover:decoration-ice">{post.data.title}</a>
                    </h3>
                    {post.data.description && <p class="mt-2 max-w-prose">{post.data.description}</p>}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</Layout>
