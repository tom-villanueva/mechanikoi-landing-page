---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
import { SHOW_BLOG } from "../config";

interface Props {
	title: string;
	description: string;
	theme?: "studio" | "iris" | "br";
}

const { title, description, theme = "studio" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Header shows these as separate groups: studio links, then the games
const studioItems = [
	{
		title: t("header.about"),
		url: translatePath("/#about")
	},
	{
		title: t("header.contact"),
		url: translatePath("/#contact")
	},
	...(SHOW_BLOG ? [{ title: "Blog", url: `/${lang}/blog` }] : [])
]

const gameItems = [
	{
		title: t("header.iris"),
		url: translatePath("/iris-dissolution")
	},
	{
		title: t("header.br"),
		url: translatePath("/bleeding-roots")
	}
]

const navGroups = [studioItems, gameItems]
const footerItems = [{ title: t("footer.home"), url: translatePath("/") }, ...studioItems, ...gameItems]
---

<!doctype html>
<html lang={lang} data-theme={theme}>
	<head>
		<meta charset="UTF-8" />
		<!-- SEO -->
		<meta name="description" content={description} />
		<meta name="keywords" content="mechanikoi,iris dissolution,bleeding roots,survival horror,indie,indie games,indie videogames,indie animation,videogames,games,games by mechanikoi">
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="index, follow" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="" />
		<meta property="og:site_name" content="Mechanikoi Games" />
		<meta name="twitter:site" content="@MechanikoiGames"/>
		
		<link
			rel="preload"
			href="/fonts/Play-Regular.ttf"
			as="font"
			crossorigin
		/>
		{theme === "iris" && (
			<>
				<link rel="preconnect" href="https://fonts.googleapis.com" />
				<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
				<link href="https://fonts.googleapis.com/css2?family=IM+Fell+English&display=swap" rel="stylesheet" />
			</>
		)}
		<link rel="icon" href="/favicon.ico" type="image/x-icon" />
		<title>{title}</title>
	</head>
	<body>
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-page">{t("header.skip")}</a>
		<div class="flex flex-col">
			<Header navGroups={navGroups}/>
			<slot />
			<Footer navItems={footerItems} />
		</div>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Play';
		src: url('/fonts/Play-Regular.ttf') format('truetype');
		font-weight: normal;
		font-style: normal;
		font-display: swap;
	}

	:root {
		color-scheme: dark;
	}

	/* RGB triplets for the theme tokens in tailwind.config.cjs */
	[data-theme="studio"] {
		--c-page: 16 24 15;
		--c-raised: 31 54 29;
		--c-ink: 5 244 64;
		--c-muted: 115 155 110;
		--c-accent: 5 244 64;
	}
	[data-theme="iris"] {
		--c-page: 13 27 30;
		--c-raised: 21 41 45;
		--c-ink: 236 230 214;
		--c-muted: 163 184 180;
		--c-accent: 127 211 230;
	}
	/* ponytail: sampled from the Bleeding Roots capsule; swap once the real palette arrives */
	[data-theme="br"] {
		--c-page: 15 13 13;
		--c-raised: 30 24 24;
		--c-ink: 226 222 220;
		--c-muted: 158 150 148;
		--c-accent: 193 18 31;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		color: rgb(var(--c-muted));
		background: rgb(var(--c-page));
	}

	/* fixed terminal grid behind the whole studio page, so content scrolls over it */
	[data-theme="studio"] body {
		background:
			linear-gradient(rgb(var(--c-accent) / 0.05) 1px, transparent 1px) 0 0 / 48px 48px fixed,
			linear-gradient(90deg, rgb(var(--c-accent) / 0.05) 1px, transparent 1px) 0 0 / 48px 48px fixed,
			rgb(var(--c-page));
	}

	/* GridWater draws the animated grid instead */
	html.grid-water[data-theme="studio"] body {
		background: rgb(var(--c-page));
	}

	:focus-visible {
		outline: 2px solid rgb(var(--c-accent));
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		*, *::before, *::after {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
