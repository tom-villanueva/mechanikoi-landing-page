---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { SHOW_BLOG } from "../config";

interface Props {
	title: string;
}

const { title } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const prePath = lang !== "es" ? `${lang}/` : ""

const allNavItems = [
	{
		title: t("header.iris"),
		url: `/${prePath}#iris`
	},
	{
		title: t("header.games"),
		url: `/${prePath}#games`
	},
	{
		title: t("header.about"),
		url: `/${prePath}#about`
	},
	{
		title: t("header.contact"),
		url: `/${prePath}#contact`
	},
	{
		title: "Blog",
		url: `/${lang}/blog`
	}
]

const navItems = allNavItems.filter((item) => SHOW_BLOG || item.title !== "Blog")
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<!-- SEO -->
		<meta name="description" content={t("meta.description")} />
		<meta name="keywords" content="iris dissolution,survival horror,mechanikoi,indie,indie games,indie videogames,indie animation,videogames,games,games by mechanikoi">
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="index, follow" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={t("meta.description")} />
		<meta property="og:url" content="" />
		<meta property="og:site_name" content="Mechanikoi Games" />
		<meta name="twitter:site" content="@MechanikoiGames"/>
		
		<link
			rel="preload"
			href="/fonts/Play-Regular.ttf"
			as="font"
			crossorigin
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IM+Fell+English&display=swap" rel="stylesheet" />
		<link rel="icon" href="/favicon.ico" type="image/x-icon" />
		<title>{title}</title>
	</head>
	<body>
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-bone focus:px-4 focus:py-2 focus:text-night">{t("header.skip")}</a>
		<div class="flex flex-col">
			<Header navItems={navItems}/>
			<slot />
			<Footer />
		</div>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Play';
		src: url('/fonts/Play-Regular.ttf') format('truetype');
		font-weight: normal;
		font-style: normal;
		font-display: swap;
	}

	:root {
		color-scheme: dark;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		color: theme("colors.fog");
		background: theme("colors.night");
	}

	:focus-visible {
		outline: 2px solid theme("colors.ice");
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		*, *::before, *::after {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
